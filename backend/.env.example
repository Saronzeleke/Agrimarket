# ============================================
# AgriMarket Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://agrimarket:dev_password@localhost:5432/agrimarket_dev?schema=public"

# ============================================
# JWT SECRETS
# ============================================
# Generate secure random strings for production
# Example: openssl rand -base64 64
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# BCRYPT
# ============================================
BCRYPT_SALT_ROUNDS=12

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
SEARCH_RATE_LIMIT_MAX_REQUESTS=20

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp
MAX_IMAGES_PER_PRODUCT=5

# ============================================
# EMAIL SERVICE
# ============================================
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@agrimarket.com
EMAIL_FROM_NAME=AgriMarket

# For development, you can use services like:
# - Mailtrap (https://mailtrap.io)
# - Ethereal Email (https://ethereal.email)

# ============================================
# PAYMENT PROVIDERS
# ============================================
# Chapa Payment Gateway (Ethiopia)
CHAPA_SECRET_KEY=your-chapa-secret-key
CHAPA_PUBLIC_KEY=your-chapa-public-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_API_URL=https://api.chapa.co/v1

# Telebirr (Ethiopia)
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_PUBLIC_KEY=your-telebirr-public-key
TELEBIRR_API_URL=https://telebirr.et/api

# Mock Payment (Development only)
USE_MOCK_PAYMENT=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE_ERROR=logs/error.log
LOG_FILE_COMBINED=logs/combined.log

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# SESSION
# ============================================
SESSION_SECRET=your-session-secret-change-in-production

# ============================================
# REDIS (for caching & sessions)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=900
CACHE_ENABLED=true

# ============================================
# CLOUDINARY (Optional - for image hosting)
# ============================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# AWS S3 (Optional - for file storage)
# ============================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=agrimarket-uploads

# ============================================
# AWS S3 (Optional - for file storage)
# ============================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=agrimarket-uploads

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry (Error Tracking)
# SENTRY_DSN=your-sentry-dsn

# Google Analytics
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RECOMMENDATIONS=true
ENABLE_REVIEWS=true
ENABLE_WISHLISTS=true

# ============================================
# DELIVERY FEE CALCULATION
# ============================================
# Base delivery fee in ETB
BASE_DELIVERY_FEE=50
# Additional fee per km (if implementing distance-based)
DELIVERY_FEE_PER_KM=5

# ============================================
# BUSINESS RULES
# ============================================
# Minimum order amount in ETB
MIN_ORDER_AMOUNT=100
# Maximum order amount in ETB (fraud prevention)
MAX_ORDER_AMOUNT=100000
# Order cancellation window in hours
ORDER_CANCELLATION_WINDOW=24
# Review edit window in days
REVIEW_EDIT_WINDOW=30
# Cart expiry in days
CART_EXPIRY_DAYS=30

# ============================================
# ADMIN SETTINGS
# ============================================
# Admin panel path (for security through obscurity)
ADMIN_PATH=/admin
# Maximum file upload size for admin (in bytes)
ADMIN_MAX_UPLOAD_SIZE=10485760

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Enable detailed error messages (disable in production)
DETAILED_ERRORS=true
# Enable SQL query logging
LOG_QUERIES=false
# Enable API request logging
LOG_REQUESTS=true
