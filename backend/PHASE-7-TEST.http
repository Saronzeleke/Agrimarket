# Phase 7 - Shopping Cart & Wishlist
# Test File for REST Client (VS Code Extension)

@baseUrl = http://localhost:3001/api/v1
@token = {{login.response.body.data.accessToken}}
@productId = {{products.response.body.data.products[0].id}}
@cartItemId = {{addToCart.response.body.data.item.id}}
@wishlistItemId = {{addToWishlist.response.body.data.item.id}}

### ====================================
### AUTHENTICATION
### ====================================

### Login as Customer
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "customer1@example.com",
  "password": "Customer123!"
}

### Get Products (to retrieve product IDs)
# @name products
GET {{baseUrl}}/products?limit=5

### ====================================
### SHOPPING CART TESTS
### ====================================

### 1. Get Empty Cart
GET {{baseUrl}}/cart
Authorization: Bearer {{token}}

### 2. Add Item to Cart
# @name addToCart
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 2
}

### 3. Add Same Product Again (Should Update Quantity)
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 1
}

### 4. Get Cart with Items
GET {{baseUrl}}/cart
Authorization: Bearer {{token}}

### 5. Update Cart Item Quantity
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 5
}

### 6. Get Cart Item Count
GET {{baseUrl}}/cart/count
Authorization: Bearer {{token}}

### 7. Validate Cart
GET {{baseUrl}}/cart/validate
Authorization: Bearer {{token}}

### 8. Remove Item from Cart
DELETE {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}

### 9. Add Multiple Different Products
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[1].id}}",
  "quantity": 1
}

### 10. Clear Entire Cart
DELETE {{baseUrl}}/cart/items
Authorization: Bearer {{token}}

### ====================================
### WISHLIST TESTS
### ====================================

### 11. Get Empty Wishlist
GET {{baseUrl}}/wishlist
Authorization: Bearer {{token}}

### 12. Add Item to Wishlist
# @name addToWishlist
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}"
}

### 13. Add Another Item to Wishlist
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[1].id}}"
}

### 14. Get Wishlist with Items
GET {{baseUrl}}/wishlist
Authorization: Bearer {{token}}

### 15. Check if Product is in Wishlist
GET {{baseUrl}}/wishlist/check/{{productId}}
Authorization: Bearer {{token}}

### 16. Get Wishlist Item Count
GET {{baseUrl}}/wishlist/count
Authorization: Bearer {{token}}

### 17. Move Item from Wishlist to Cart
POST {{baseUrl}}/wishlist/items/{{wishlistItemId}}/move-to-cart
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 2
}

### 18. Move Item with Default Quantity (1)
POST {{baseUrl}}/wishlist/items/{{wishlistItemId}}/move-to-cart
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 19. Add Items Back to Wishlist for Move All Test
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[2].id}}"
}

###
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[3].id}}"
}

### 20. Move All Items from Wishlist to Cart
POST {{baseUrl}}/wishlist/move-all-to-cart
Authorization: Bearer {{token}}

### 21. Remove Item from Wishlist by Item ID
DELETE {{baseUrl}}/wishlist/items/{{wishlistItemId}}
Authorization: Bearer {{token}}

### 22. Remove Item from Wishlist by Product ID
DELETE {{baseUrl}}/wishlist/products/{{productId}}
Authorization: Bearer {{token}}

### 23. Clear Entire Wishlist
DELETE {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}

### ====================================
### ERROR SCENARIOS
### ====================================

### 24. Add to Cart Without Authentication
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 1
}

### 25. Add Invalid Product to Cart
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "invalid-uuid",
  "quantity": 1
}

### 26. Add with Zero Quantity
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 0
}

### 27. Add with Negative Quantity
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": -5
}

### 28. Add Excessive Quantity (Over 1000)
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 1001
}

### 29. Add Quantity Exceeding Stock
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 99999
}

### 30. Update with Invalid Quantity
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 0
}

### 31. Remove Non-Existent Cart Item
DELETE {{baseUrl}}/cart/items/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### 32. Add Already Wishlisted Product
# First add to wishlist
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}"
}

###
# Then try to add again
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}"
}

### 33. Remove Non-Existent Wishlist Item
DELETE {{baseUrl}}/wishlist/items/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### 34. Move Non-Existent Item to Cart
POST {{baseUrl}}/wishlist/items/00000000-0000-0000-0000-000000000000/move-to-cart
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 1
}

### ====================================
### INTEGRATION SCENARIOS
### ====================================

### 35. Complete Flow: Product → Wishlist → Cart
# Step 1: Add to wishlist
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[4].id}}"
}

###
# Step 2: Check counts
GET {{baseUrl}}/wishlist/count
Authorization: Bearer {{token}}

###
# Step 3: Move to cart
# Use item ID from step 1 response
POST {{baseUrl}}/wishlist/items/{{wishlistItemId}}/move-to-cart
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 1
}

###
# Step 4: Verify in cart
GET {{baseUrl}}/cart
Authorization: Bearer {{token}}

###
# Step 5: Verify removed from wishlist
GET {{baseUrl}}/wishlist
Authorization: Bearer {{token}}

### 36. Cart → Wishlist Workflow
# Step 1: Add to cart
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 3
}

###
# Step 2: Update quantity
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 5
}

###
# Step 3: Validate before checkout
GET {{baseUrl}}/cart/validate
Authorization: Bearer {{token}}

###
# Step 4: Remove from cart
DELETE {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}

###
# Step 5: Add to wishlist for later
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}"
}

### 37. Batch Operations Test
# Add multiple items to wishlist
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[0].id}}"
}

###
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[1].id}}"
}

###
POST {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{products.response.body.data.products[2].id}}"
}

###
# Move all to cart at once
POST {{baseUrl}}/wishlist/move-all-to-cart
Authorization: Bearer {{token}}

###
# Verify all moved
GET {{baseUrl}}/cart
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/wishlist
Authorization: Bearer {{token}}

### ====================================
### EDGE CASES
### ====================================

### 38. Add to Cart with Variant
POST {{baseUrl}}/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "variantId": "variant-uuid-if-exists",
  "quantity": 1
}

### 39. Get Cart Summary
GET {{baseUrl}}/cart
Authorization: Bearer {{token}}

### 40. Multiple Updates to Same Item
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 2
}

###
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 5
}

###
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 1
}

### ====================================
### CLEANUP
### ====================================

### 41. Clear All Data
DELETE {{baseUrl}}/cart/items
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/wishlist/items
Authorization: Bearer {{token}}

### ====================================
### NOTES
### ====================================

# To use this file:
# 1. Install "REST Client" extension in VS Code
# 2. Start your backend server: npm run dev
# 3. Make sure you have products seeded in database
# 4. Click "Send Request" above each ### line
# 5. Variables like {{token}} and {{productId}} are automatically extracted
# 6. Tests #24-34 should return errors (they test error handling)
# 7. Run tests in order for best results
