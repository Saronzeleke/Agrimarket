###
# Phase 13: Reviews & Ratings System - API Testing
# 
# Prerequisites:
# 1. Server running on http://localhost:3000
# 2. Database seeded with test data
# 3. Valid customer, seller, and admin access tokens
# 4. Customer must have purchased (DELIVERED order) a product to review it
###

@baseUrl = http://localhost:3000/api/v1
@customerToken = YOUR_CUSTOMER_ACCESS_TOKEN_HERE
@sellerToken = YOUR_SELLER_ACCESS_TOKEN_HERE
@adminToken = YOUR_ADMIN_ACCESS_TOKEN_HERE
@productId = PRODUCT_ID_HERE
@orderId = ORDER_ID_HERE
@reviewId = REVIEW_ID_HERE

###############################################################################
# 1. Submit Product Reviews (Customer)
###############################################################################

### Submit a new review
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 5,
  "title": "Excellent Product!",
  "comment": "This product exceeded my expectations. Quality is great and delivery was fast."
}

### Submit review with minimum fields
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 4
}

### Try to submit duplicate review (should fail)
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 5,
  "title": "Second review",
  "comment": "Trying to submit another review for same product"
}

###############################################################################
# 2. View Product Reviews (Public)
###############################################################################

### Get all reviews for a product
GET {{baseUrl}}/products/{{productId}}/reviews

### Get reviews with pagination
GET {{baseUrl}}/products/{{productId}}/reviews?page=1&limit=10

### Filter by rating (5 stars only)
GET {{baseUrl}}/products/{{productId}}/reviews?rating=5

### Filter verified purchases only
GET {{baseUrl}}/products/{{productId}}/reviews?verifiedOnly=true

### Sort by rating (highest first)
GET {{baseUrl}}/products/{{productId}}/reviews?sortBy=rating

### Sort by helpful votes
GET {{baseUrl}}/products/{{productId}}/reviews?sortBy=helpful

### Sort by most recent
GET {{baseUrl}}/products/{{productId}}/reviews?sortBy=recent

### Combined filters
GET {{baseUrl}}/products/{{productId}}/reviews?rating=5&verifiedOnly=true&sortBy=helpful&page=1&limit=5

###############################################################################
# 3. Get Review Statistics (Public)
###############################################################################

### Get product review statistics
GET {{baseUrl}}/products/{{productId}}/reviews/stats

###############################################################################
# 4. Manage Own Reviews (Customer)
###############################################################################

### Get review by ID
GET {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{customerToken}}

### Update own review
PATCH {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "rating": 4,
  "title": "Updated: Good Product",
  "comment": "After using it for a while, I'd say it's good but not perfect."
}

### Update only rating
PATCH {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "rating": 5
}

### Delete own review
DELETE {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{customerToken}}

###############################################################################
# 5. Helpful Voting (Authenticated Users)
###############################################################################

### Mark review as helpful
POST {{baseUrl}}/reviews/{{reviewId}}/helpful
Authorization: Bearer {{customerToken}}

### Toggle helpful (remove vote if already voted)
POST {{baseUrl}}/reviews/{{reviewId}}/helpful
Authorization: Bearer {{customerToken}}

### Try to mark own review as helpful (should fail)
POST {{baseUrl}}/reviews/{{reviewId}}/helpful
Authorization: Bearer {{customerToken}}

###############################################################################
# 6. Flag Reviews (Authenticated Users)
###############################################################################

### Flag a review for moderation
POST {{baseUrl}}/reviews/{{reviewId}}/flag
Authorization: Bearer {{customerToken}}

### Try to flag already flagged review (should fail)
POST {{baseUrl}}/reviews/{{reviewId}}/flag
Authorization: Bearer {{customerToken}}

###############################################################################
# 7. Seller Review Management
###############################################################################

### Get seller's product reviews
GET {{baseUrl}}/seller/reviews
Authorization: Bearer {{sellerToken}}

### Get reviews that need response
GET {{baseUrl}}/seller/reviews?needsResponse=true
Authorization: Bearer {{sellerToken}}

### Get reviews with pagination
GET {{baseUrl}}/seller/reviews?page=1&limit=10
Authorization: Bearer {{sellerToken}}

### Respond to a review
POST {{baseUrl}}/seller/reviews/{{reviewId}}/respond
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "response": "Thank you for your feedback! We're glad you enjoyed our product. We appreciate your business!"
}

### Try to respond twice (should fail)
POST {{baseUrl}}/seller/reviews/{{reviewId}}/respond
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "response": "Another response"
}

###############################################################################
# 8. Admin Review Moderation
###############################################################################

### Get flagged reviews
GET {{baseUrl}}/admin/reviews/flagged
Authorization: Bearer {{adminToken}}

### Get flagged reviews with pagination
GET {{baseUrl}}/admin/reviews/flagged?page=1&limit=20
Authorization: Bearer {{adminToken}}

### Approve a review
PATCH {{baseUrl}}/admin/reviews/{{reviewId}}/moderate
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "approved": true
}

### Reject a review
PATCH {{baseUrl}}/admin/reviews/{{reviewId}}/moderate
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "approved": false
}

### Delete a review (admin)
DELETE {{baseUrl}}/admin/reviews/{{reviewId}}
Authorization: Bearer {{adminToken}}

###############################################################################
# Error Cases - Validation Testing
###############################################################################

### Invalid rating (too low)
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 0,
  "title": "Test",
  "comment": "Testing invalid rating"
}

### Invalid rating (too high)
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 6,
  "title": "Test",
  "comment": "Testing invalid rating"
}

### Title too short
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 5,
  "title": "AB",
  "comment": "Title is too short"
}

### Comment too short
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 5,
  "title": "Test Review",
  "comment": "Short"
}

### Missing required fields
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "rating": 5
}

### Invalid product ID
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "invalid-id",
  "orderId": "{{orderId}}",
  "rating": 5
}

### No authentication token
GET {{baseUrl}}/reviews/{{reviewId}}

### Non-customer trying to submit review
POST {{baseUrl}}/reviews
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 5
}

### Customer trying to respond to review (should fail - sellers only)
POST {{baseUrl}}/seller/reviews/{{reviewId}}/respond
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "response": "Thanks!"
}

### Non-admin trying to moderate
PATCH {{baseUrl}}/admin/reviews/{{reviewId}}/moderate
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "approved": true
}

###############################################################################
# Integration Testing - Complete Review Lifecycle
###############################################################################

### Step 1: Customer submits a review
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "orderId": "{{orderId}}",
  "rating": 5,
  "title": "Great product!",
  "comment": "I love this product. The quality is excellent and it arrived quickly."
}

### Step 2: Another customer marks it as helpful
POST {{baseUrl}}/reviews/{{reviewId}}/helpful
Authorization: Bearer {{customerToken}}

### Step 3: View the review with helpful count
GET {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{customerToken}}

### Step 4: Seller responds to the review
POST {{baseUrl}}/seller/reviews/{{reviewId}}/respond
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "response": "Thank you so much for your kind words! We're delighted you love the product."
}

### Step 5: View product reviews with seller response
GET {{baseUrl}}/products/{{productId}}/reviews

### Step 6: Check product statistics
GET {{baseUrl}}/products/{{productId}}/reviews/stats

### Step 7: Customer updates their review
PATCH {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Still good, but noticed a minor issue after extended use."
}

### Step 8: Someone flags the review
POST {{baseUrl}}/reviews/{{reviewId}}/flag
Authorization: Bearer {{customerToken}}

### Step 9: Admin reviews flagged reviews
GET {{baseUrl}}/admin/reviews/flagged
Authorization: Bearer {{adminToken}}

### Step 10: Admin approves the review
PATCH {{baseUrl}}/admin/reviews/{{reviewId}}/moderate
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "approved": true
}

###
