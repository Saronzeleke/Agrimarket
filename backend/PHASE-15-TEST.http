###
# Phase 15: Notification System - API Testing
# 
# Prerequisites:
# 1. Server running on http://localhost:3000
# 2. Database with test data
# 3. Valid customer access token
# 4. Some notifications created for the user
###

@baseUrl = http://localhost:3000/api/v1
@customerToken = YOUR_CUSTOMER_ACCESS_TOKEN_HERE
@notificationId = NOTIFICATION_ID_HERE

###############################################################################
# 1. Get Notifications
###############################################################################

### Get all notifications (with pagination)
GET {{baseUrl}}/notifications
Authorization: Bearer {{customerToken}}

### Get notifications - Page 2
GET {{baseUrl}}/notifications?page=2&limit=10
Authorization: Bearer {{customerToken}}

### Get only unread notifications
GET {{baseUrl}}/notifications?read=false
Authorization: Bearer {{customerToken}}

### Get only read notifications
GET {{baseUrl}}/notifications?read=true
Authorization: Bearer {{customerToken}}

### Get notifications by type (ORDER_CREATED)
GET {{baseUrl}}/notifications?type=ORDER_CREATED
Authorization: Bearer {{customerToken}}

### Get notifications by type (ORDER_SHIPPED)
GET {{baseUrl}}/notifications?type=ORDER_SHIPPED
Authorization: Bearer {{customerToken}}

### Combined filters - Unread order notifications
GET {{baseUrl}}/notifications?read=false&type=ORDER_CREATED
Authorization: Bearer {{customerToken}}

###############################################################################
# 2. Notification Details
###############################################################################

### Get notification by ID
GET {{baseUrl}}/notifications/{{notificationId}}
Authorization: Bearer {{customerToken}}

### Get recent notifications (last 10)
GET {{baseUrl}}/notifications/recent
Authorization: Bearer {{customerToken}}

### Get recent notifications with custom limit
GET {{baseUrl}}/notifications/recent?limit=5
Authorization: Bearer {{customerToken}}

###############################################################################
# 3. Unread Count
###############################################################################

### Get unread notification count
GET {{baseUrl}}/notifications/unread/count
Authorization: Bearer {{customerToken}}

###############################################################################
# 4. Mark Notifications as Read/Unread
###############################################################################

### Mark specific notification as read
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{customerToken}}

### Mark specific notification as unread
PATCH {{baseUrl}}/notifications/{{notificationId}}/unread
Authorization: Bearer {{customerToken}}

### Mark all notifications as read
PATCH {{baseUrl}}/notifications/read-all
Authorization: Bearer {{customerToken}}

###############################################################################
# 5. Delete Notifications
###############################################################################

### Delete specific notification
DELETE {{baseUrl}}/notifications/{{notificationId}}
Authorization: Bearer {{customerToken}}

### Delete all notifications
DELETE {{baseUrl}}/notifications
Authorization: Bearer {{customerToken}}

###############################################################################
# Error Cases - Validation Testing
###############################################################################

### No authentication token
GET {{baseUrl}}/notifications

### Invalid page number
GET {{baseUrl}}/notifications?page=0
Authorization: Bearer {{customerToken}}

### Invalid limit (too high)
GET {{baseUrl}}/notifications?limit=1000
Authorization: Bearer {{customerToken}}

### Invalid notification type
GET {{baseUrl}}/notifications?type=INVALID_TYPE
Authorization: Bearer {{customerToken}}

### Non-existent notification ID
GET {{baseUrl}}/notifications/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{customerToken}}

### Try to access another user's notification (should fail)
GET {{baseUrl}}/notifications/{{notificationId}}
Authorization: Bearer ANOTHER_USER_TOKEN

###############################################################################
# Integration Testing - Complete User Journey
###############################################################################

### Step 1: User logs in, checks unread count
GET {{baseUrl}}/notifications/unread/count
Authorization: Bearer {{customerToken}}

### Step 2: User gets recent notifications
GET {{baseUrl}}/notifications/recent?limit=10
Authorization: Bearer {{customerToken}}

### Step 3: User views a specific notification
GET {{baseUrl}}/notifications/{{notificationId}}
Authorization: Bearer {{customerToken}}

### Step 4: User marks notification as read
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{customerToken}}

### Step 5: User checks unread count again (should be reduced)
GET {{baseUrl}}/notifications/unread/count
Authorization: Bearer {{customerToken}}

### Step 6: User gets all notifications with pagination
GET {{baseUrl}}/notifications?page=1&limit=20
Authorization: Bearer {{customerToken}}

### Step 7: User filters by notification type
GET {{baseUrl}}/notifications?type=ORDER_DELIVERED
Authorization: Bearer {{customerToken}}

### Step 8: User marks all as read
PATCH {{baseUrl}}/notifications/read-all
Authorization: Bearer {{customerToken}}

### Step 9: User deletes a specific notification
DELETE {{baseUrl}}/notifications/{{notificationId}}
Authorization: Bearer {{customerToken}}

### Step 10: User checks remaining notifications
GET {{baseUrl}}/notifications
Authorization: Bearer {{customerToken}}

###############################################################################
# Use Case Testing - Different Notification Types
###############################################################################

### Order notifications
GET {{baseUrl}}/notifications?type=ORDER_CREATED
Authorization: Bearer {{customerToken}}

### Payment notifications
GET {{baseUrl}}/notifications?type=PAYMENT_CONFIRMED
Authorization: Bearer {{customerToken}}

### Shipping notifications
GET {{baseUrl}}/notifications?type=ORDER_SHIPPED
Authorization: Bearer {{customerToken}}

### Delivery notifications
GET {{baseUrl}}/notifications?type=ORDER_DELIVERED
Authorization: Bearer {{customerToken}}

### Low stock notifications (for sellers)
GET {{baseUrl}}/notifications?type=LOW_STOCK
Authorization: Bearer {{customerToken}}

### Review notifications (for sellers)
GET {{baseUrl}}/notifications?type=NEW_REVIEW
Authorization: Bearer {{customerToken}}

###############################################################################
# Performance Testing - Various Page Sizes
###############################################################################

### Small page size (5 items)
GET {{baseUrl}}/notifications?limit=5
Authorization: Bearer {{customerToken}}

### Medium page size (20 items - default)
GET {{baseUrl}}/notifications?limit=20
Authorization: Bearer {{customerToken}}

### Large page size (50 items)
GET {{baseUrl}}/notifications?limit=50
Authorization: Bearer {{customerToken}}

### Maximum page size (100 items)
GET {{baseUrl}}/notifications?limit=100
Authorization: Bearer {{customerToken}}

###############################################################################
# Edge Cases
###############################################################################

### Get notifications when none exist
GET {{baseUrl}}/notifications
Authorization: Bearer {{customerToken}}

### Mark as read when already read
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{customerToken}}

### Mark as unread when already unread
PATCH {{baseUrl}}/notifications/{{notificationId}}/unread
Authorization: Bearer {{customerToken}}

### Delete all when no notifications exist
DELETE {{baseUrl}}/notifications
Authorization: Bearer {{customerToken}}

### Default limit (no limit parameter)
GET {{baseUrl}}/notifications
Authorization: Bearer {{customerToken}}

###
